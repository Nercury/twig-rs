   },
   "data_php": "return ['p' => \\DatePeriod::createFromISO8601String('R2/2012-07-01T00:00:00Z/P7D'), 'q' => (function () { $q = new \\DatePeriod(new \\DateTime('2020-02-28'), new \\DateInterval('P1D'), 2); foreach ($q as $d) {} return $q; })()]",
